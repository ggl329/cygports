category: Graphics
requires: cygwin libfreetype6 libgcc1 libgif7 libharfbuzz0 libiconv2 libintl8 libjpeg8 libpng16 libreadline8 libspiro1 libstdc++6 libtiff7 libwoff2_1 libxml2 python312 zlib0 fontforge-common
sdesc: "Font creation, editing, and conversion (runtime)"
ldesc: "An outline font editor that lets you create your own postscript,
truetype, opentype, cid-keyed, multi-master, cff, svg and bitmap (bdf, FON,
NFNT) fonts, or edit existing ones. Also lets you convert one format to
another."
external-source: fontforge

